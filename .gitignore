# Go build artifacts
/autoto
/bin/
/dist/
*.exe
*.exe~
# Kept-aside binaries from manual rollback testing, e.g. autoto.exe.prev-running.
*.exe.prev-*
*.test
*.out
coverage.out
*.coverprofile
/coverage/

# Local runtime data
*.db
*.db-shm
*.db-wal

# Local environment/config secrets
.env
.env.*
config.local.json

# Logs and temporary files
*.log
tmp/
.autoto-run-*.json
.DS_Store
.worktrees/
.smoke/

# Local source/reference repositories
/autoto-legacy/

# Scratch scripts kept beside the source while debugging. They are working
# notes, not part of the build, and they accumulate fast.
_tmp_*

# Internal working documents that stay on the maintainer's machine only.
# These are local planning notes, code-review audits, and proposals; they
# are not part of the public product and must never be pushed to GitHub.
internal-docs/
